
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dataset {
  id             String   @id @default(uuid())
  name           String
  owner          String
  hash           String
  fileEncryption Json
  cid            String?
  tokenId        Int?     @unique
  verification   Json?
  ipfsUrl        String?
  tokenUri       String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}